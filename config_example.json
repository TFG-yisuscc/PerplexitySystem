{
  "_comment": "config_example.json — copy and adapt one example below. Remove all _ fields before use.",

  "_example_llama_single": {
    "inference_engine": "LLAMA",
    "corpus_path":  "corpus/wiki.test.raw",
    "model_path":   "/path/to/model.gguf",
    "context_size": 512,
    "batch_size":   512,
    "n_threads":    4,
    "seed":         0,
    "output_dir":   "results",
    "annotations":  {"serie": "E1", "quant": "Q4_K_M"}
  },

  "_example_llama_batch": {
    "inference_engine": "LLAMA",
    "model_paths": [
      "/path/to/model_q4_k_m.gguf",
      "/path/to/model_q8_0.gguf",
      "/path/to/model_fp16.gguf"
    ],
    "context_size": 512,
    "batch_size":   512,
    "n_threads":    4,
    "output_dir":   "results",
    "annotations":  {"serie": "E1", "experiment": "quant_sweep"}
  },

  "_example_ollama_single": {
    "inference_engine":   "OLLAMA",
    "ollama_model_name":  "llama3.2:1b",
    "model_path":         "/path/to/llama3.2-1b.gguf",
    "ollama_url":         "http://localhost:11434",
    "top_logprobs_k":     20,
    "ollama_raw":         true,
    "context_size":       512,
    "output_dir":         "results",
    "annotations":        {"serie": "E4", "experiment": "ollama_vs_llama_cpp"}
  },

  "_example_ollama_batch": {
    "inference_engine":    "OLLAMA",
    "ollama_model_names":  ["llama3.2:1b", "llama3.2:3b", "gemma3n:e2b"],
    "model_path":          "/path/to/shared_tokenizer.gguf",
    "context_size":        512,
    "top_logprobs_k":      20,
    "output_dir":          "results",
    "annotations":         {"serie": "E4", "experiment": "model_comparison"}
  },

  "_example_embedded_corpus": {
    "inference_engine": "LLAMA",
    "model_path":       "/path/to/model.gguf",
    "context_size":     512,
    "output_dir":       "results",
    "_note": "No corpus_path → uses wiki.test.raw embedded in the binary"
  },

  "_usage_note": [
    "corpus_path is optional — omit it to use the wiki.test.raw embedded in the binary.",
    "",
    "LLAMA engine:  model_path (single) or model_paths (batch, array of GGUF paths).",
    "OLLAMA engine: ollama_model_name (single) or ollama_model_names (batch array).",
    "               model_path = GGUF tokeniser, loaded once and shared across all Ollama models.",
    "               Requires: ollama serve && ollama pull <model_name>",
    "               Requires Ollama >= 0.12.11 (logprobs support)."
  ]
}
